const SHEET_NAME="CBT_Essay";
function doPost(e){try{const d=JSON.parse(e.postData.contents);const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh){sh=ss.insertSheet(SHEET_NAME);sh.appendRow(["Timestamp","ID_Ujian","NIS","NISN","Nama","Kelas","Mapel","Soal1","Jawab1","Soal2","Jawab2","Soal3","Jawab3","Status","Skor_AI","Feedback_AI","Rincian"]);}if(d.action==="correct"){sh.getRange(d.row,14,1,4).setValues([["Sudah Dikoreksi",d.skor,d.feedback,d.rincian]]);return jsonOut({ok:true});}const id="CBT-"+Date.now().toString(36).toUpperCase();sh.appendRow([new Date(),id,d.nis||"",d.nisn||"",d.nama,d.kelas,d.mapel||"Umum",d.jawaban[0]?.soal||"",d.jawaban[0]?.jawaban||"",d.jawaban[1]?.soal||"",d.jawaban[1]?.jawaban||"",d.jawaban[2]?.soal||"",d.jawaban[2]?.jawaban||"","Belum Dikoreksi","","",""]);return jsonOut({ok:true,id});}catch(err){return jsonOut({ok:false,error:err.toString()});}}
function doGet(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh)return jsonOut([]);const rows=sh.getDataRange().getValues();const out=[];for(let i=1;i<rows.length;i++){const r=rows[i];out.push({rowIndex:i+1,timestamp:r[0],id:r[1],nis:r[2],nisn:r[3],nama:r[4],kelas:r[5],mapel:r[6],soal1:r[7],jawab1:r[8],soal2:r[9],jawab2:r[10],soal3:r[11],jawab3:r[12],status:r[13],skor:r[14],feedback:r[15],rincian:r[16]});}return jsonOut(out.reverse());}
function jsonOut(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
